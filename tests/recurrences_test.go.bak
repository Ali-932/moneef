package tests

import (
	"encoding/json"
	"fmt"
	"net/http"
	"net/http/httptest"
	"testing"
	"time"

	"github.com/go-chi/chi/v5"
	chiMiddleware "github.com/go-chi/chi/v5/middleware"
	"github.com/shopspring/decimal"
	"github.com/stretchr/testify/assert"
	"moneef/internal/models"
	"moneef/internal/recurrences"
	"moneef/pkg/middleware"
	"moneef/pkg/types"
)

func setupRecurrenceRouter() *chi.Mux {
	r := chi.NewRouter()
	r.Route("/api/v1", func(r chi.Router) {
		r.Use(chiMiddleware.Logger)
		r.Use(middleware.AuthMiddleware)
		r.Route("/recurrence", func(r chi.Router) {
			r.Get("/", recurrences.ListRecurrencesHandler)
			r.Get("/timeline", recurrences.GetTimelineHandler)
			r.Put("/{id}", recurrences.UpdateRecurrenceHandler)
			r.Delete("/{id}", recurrences.DeleteRecurrenceHandler)
		})
	})
	return r
}

func seedRecurrence(suite *TestSuite) models.RecurrenceTemplate {
	amount := types.Money(decimal.NewFromFloat(50.00))
	tpl := models.RecurrenceTemplate{
		ProfileID:         testProfileID,
		Name:              "Netflix",
		Type:              "expense",
		CurrencyCode:      "USD",
		Icon:              "📺",
		Color:             "#E50914",
		Frequency:         "monthly",
		NextDate:          time.Now().AddDate(0, 0, 7),
		NextPaymentAmount: &amount,
		IsActive:          true,
	}
	suite.DB.Create(&tpl)
	return tpl
}

func TestListRecurrences(t *testing.T) {
	suite := NewTestSuite(t)
	defer suite.Cleanup()
	seedRecurrence(suite)

	r := setupRecurrenceRouter()
	req := suite.createAuthenticatedRequest(http.MethodGet, "/api/v1/recurrence/", nil)
	w := httptest.NewRecorder()
	r.ServeHTTP(w, req)

	assert.Equal(t, http.StatusOK, w.Code)
	var result []map[string]interface{}
	assert.NoError(t, json.Unmarshal(w.Body.Bytes(), &result))
	assert.Equal(t, 1, len(result))
}

func TestDeleteRecurrence(t *testing.T) {
	suite := NewTestSuite(t)
	defer suite.Cleanup()
	tpl := seedRecurrence(suite)

	r := setupRecurrenceRouter()
	req := suite.createAuthenticatedRequest(http.MethodDelete, fmt.Sprintf("/api/v1/recurrence/%d", tpl.ID), nil)
	w := httptest.NewRecorder()
	r.ServeHTTP(w, req)

	assert.Equal(t, http.StatusNoContent, w.Code)
	var check models.RecurrenceTemplate
	suite.DB.Unscoped().First(&check, tpl.ID)
	assert.NotNil(t, check.DeletedAt)
}

func TestUpdateRecurrence(t *testing.T) {
	suite := NewTestSuite(t)
	defer suite.Cleanup()
	tpl := seedRecurrence(suite)

	r := setupRecurrenceRouter()
	body, _ := json.Marshal(map[string]interface{}{"name": "Spotify", "frequency": "monthly"})
	req := suite.createAuthenticatedRequest(http.MethodPut, fmt.Sprintf("/api/v1/recurrence/%d", tpl.ID), body)
	w := httptest.NewRecorder()
	r.ServeHTTP(w, req)

	assert.Equal(t, http.StatusOK, w.Code)
	var check models.RecurrenceTemplate
	suite.DB.First(&check, tpl.ID)
	assert.Equal(t, "Spotify", check.Name)
}

func TestGetTimeline(t *testing.T) {
	now := time.Now().UTC()
	monthStart := time.Date(now.Year(), now.Month(), 1, 0, 0, 0, 0, time.UTC)

	t.Run("Daily template produces multiple occurrences", func(t *testing.T) {
		suite := NewTestSuite(t)
		defer suite.Cleanup()

		amount := types.Money(decimal.NewFromFloat(10.00))
		tpl := models.RecurrenceTemplate{
			ProfileID:         testProfileID,
			Name:              "Daily Coffee",
			Type:              "expense",
			CurrencyCode:      "USD",
			Icon:              "☕",
			Color:             "#8B4513",
			Frequency:         "daily",
			NextDate:          monthStart.AddDate(0, 0, 5),
			NextPaymentAmount: &amount,
			IsActive:          true,
		}
		suite.DB.Create(&tpl)

		r := setupRecurrenceRouter()
		req := suite.createAuthenticatedRequest(http.MethodGet, "/api/v1/recurrence/timeline", nil)
		w := httptest.NewRecorder()
		r.ServeHTTP(w, req)

		assert.Equal(t, http.StatusOK, w.Code)
		var result []map[string]interface{}
		assert.NoError(t, json.Unmarshal(w.Body.Bytes(), &result))
		assert.GreaterOrEqual(t, len(result), 2, "Daily template should produce multiple occurrences")
	})

	t.Run("Monthly template with future NextDate projects backward", func(t *testing.T) {
		suite := NewTestSuite(t)
		defer suite.Cleanup()

		amount := types.Money(decimal.NewFromFloat(100.00))
		tpl := models.RecurrenceTemplate{
			ProfileID:         testProfileID,
			Name:              "Future Rent",
			Type:              "expense",
			CurrencyCode:      "USD",
			Icon:              "🏠",
			Color:             "#EF4444",
			Frequency:         "monthly",
			NextDate:          monthStart.AddDate(0, 1, 0), // next month
			NextPaymentAmount: &amount,
			IsActive:          true,
		}
		suite.DB.Create(&tpl)

		r := setupRecurrenceRouter()
		req := suite.createAuthenticatedRequest(http.MethodGet, "/api/v1/recurrence/timeline", nil)
		w := httptest.NewRecorder()
		r.ServeHTTP(w, req)

		assert.Equal(t, http.StatusOK, w.Code)
		var result []map[string]interface{}
		assert.NoError(t, json.Unmarshal(w.Body.Bytes(), &result))
		found := false
		for _, occ := range result {
			if occ["name"] == "Future Rent" {
				found = true
				break
			}
		}
		assert.True(t, found, "Backward projection should produce occurrence in current month")
	})

	t.Run("Monthly template on day 31 clamps correctly", func(t *testing.T) {
		suite := NewTestSuite(t)
		defer suite.Cleanup()

		amount := types.Money(decimal.NewFromFloat(50.00))
		// Set NextDate to day 31 of a month that has 31 days
		nextDate := time.Date(now.Year(), now.Month(), 31, 0, 0, 0, 0, time.UTC)
		if nextDate.Day() != 31 {
			// Current month doesn't have 31 days, use previous month
			nextDate = monthStart.AddDate(0, -1, 0)
			for nextDate.Day() != 31 {
				nextDate = nextDate.AddDate(0, -1, 0)
			}
		}
		tpl := models.RecurrenceTemplate{
			ProfileID:         testProfileID,
			Name:              "Day31 Bill",
			Type:              "expense",
			CurrencyCode:      "USD",
			Icon:              "📅",
			Color:             "#F59E0B",
			Frequency:         "monthly",
			NextDate:          nextDate,
			NextPaymentAmount: &amount,
			IsActive:          true,
		}
		suite.DB.Create(&tpl)

		r := setupRecurrenceRouter()
		req := suite.createAuthenticatedRequest(http.MethodGet, "/api/v1/recurrence/timeline", nil)
		w := httptest.NewRecorder()
		r.ServeHTTP(w, req)

		assert.Equal(t, http.StatusOK, w.Code)
		var result []map[string]interface{}
		assert.NoError(t, json.Unmarshal(w.Body.Bytes(), &result))
		for _, occ := range result {
			if occ["name"] == "Day31 Bill" {
				date, _ := time.Parse(time.RFC3339, occ["date"].(string))
				assert.LessOrEqual(t, date.Day(), now.AddDate(0, 1, -now.Day()).Day(), "Day should be clamped to month max")
			}
		}
	})

	t.Run("Expired template is excluded", func(t *testing.T) {
		suite := NewTestSuite(t)
		defer suite.Cleanup()

		amount := types.Money(decimal.NewFromFloat(30.00))
		endDate := monthStart.AddDate(0, 0, -1)
		tpl := models.RecurrenceTemplate{
			ProfileID:         testProfileID,
			Name:              "Expired Sub",
			Type:              "expense",
			CurrencyCode:      "USD",
			Icon:              "❌",
			Color:             "#6B7280",
			Frequency:         "monthly",
			NextDate:          monthStart.AddDate(0, -1, 0),
			NextPaymentAmount: &amount,
			IsActive:          true,
			HasEndDate:        true,
			EndDate:           &endDate,
		}
		suite.DB.Create(&tpl)

		r := setupRecurrenceRouter()
		req := suite.createAuthenticatedRequest(http.MethodGet, "/api/v1/recurrence/timeline", nil)
		w := httptest.NewRecorder()
		r.ServeHTTP(w, req)

		assert.Equal(t, http.StatusOK, w.Code)
		var result []map[string]interface{}
		assert.NoError(t, json.Unmarshal(w.Body.Bytes(), &result))
		for _, occ := range result {
			assert.NotEqual(t, "Expired Sub", occ["name"], "Expired template should be excluded")
		}
	})

	t.Run("Nil NextPaymentAmount is excluded", func(t *testing.T) {
		suite := NewTestSuite(t)
		defer suite.Cleanup()

		tpl := models.RecurrenceTemplate{
			ProfileID:    testProfileID,
			Name:         "Nil Amount",
			Type:         "expense",
			CurrencyCode: "USD",
			Icon:         "🚫",
			Color:        "#6B7280",
			Frequency:    "monthly",
			NextDate:     monthStart.AddDate(0, 0, 5),
			IsActive:     true,
		}
		suite.DB.Create(&tpl)

		r := setupRecurrenceRouter()
		req := suite.createAuthenticatedRequest(http.MethodGet, "/api/v1/recurrence/timeline", nil)
		w := httptest.NewRecorder()
		r.ServeHTTP(w, req)

		assert.Equal(t, http.StatusOK, w.Code)
		var result []map[string]interface{}
		assert.NoError(t, json.Unmarshal(w.Body.Bytes(), &result))
		for _, occ := range result {
			assert.NotEqual(t, "Nil Amount", occ["name"], "Nil amount template should be excluded")
		}
	})

	t.Run("Income and expense both returned", func(t *testing.T) {
		suite := NewTestSuite(t)
		defer suite.Cleanup()

		incomeAmount := types.Money(decimal.NewFromFloat(1000.00))
		expenseAmount := types.Money(decimal.NewFromFloat(350.00))

		incomeTpl := models.RecurrenceTemplate{
			ProfileID:         testProfileID,
			Name:              "Salary",
			Type:              "income",
			CurrencyCode:      "USD",
			Icon:              "💰",
			Color:             "#22C55E",
			Frequency:         "monthly",
			NextDate:          monthStart.AddDate(0, 0, 1),
			NextPaymentAmount: &incomeAmount,
			IsActive:          true,
		}
		expenseTpl := models.RecurrenceTemplate{
			ProfileID:         testProfileID,
			Name:              "Rent",
			Type:              "expense",
			CurrencyCode:      "USD",
			Icon:              "🏠",
			Color:             "#EF4444",
			Frequency:         "monthly",
			NextDate:          monthStart.AddDate(0, 0, 1),
			NextPaymentAmount: &expenseAmount,
			IsActive:          true,
		}
		suite.DB.Create(&incomeTpl)
		suite.DB.Create(&expenseTpl)

		r := setupRecurrenceRouter()
		req := suite.createAuthenticatedRequest(http.MethodGet, "/api/v1/recurrence/timeline", nil)
		w := httptest.NewRecorder()
		r.ServeHTTP(w, req)

		assert.Equal(t, http.StatusOK, w.Code)
		var result []map[string]interface{}
		assert.NoError(t, json.Unmarshal(w.Body.Bytes(), &result))
		var foundIncome, foundExpense bool
		for _, occ := range result {
			if occ["name"] == "Salary" && occ["type"] == "income" {
				foundIncome = true
			}
			if occ["name"] == "Rent" && occ["type"] == "expense" {
				foundExpense = true
			}
		}
		assert.True(t, foundIncome, "Income template should be returned")
		assert.True(t, foundExpense, "Expense template should be returned")
	})

	t.Run("Empty result when no active templates", func(t *testing.T) {
		suite := NewTestSuite(t)
		defer suite.Cleanup()

		r := setupRecurrenceRouter()
		req := suite.createAuthenticatedRequest(http.MethodGet, "/api/v1/recurrence/timeline", nil)
		w := httptest.NewRecorder()
		r.ServeHTTP(w, req)

		assert.Equal(t, http.StatusOK, w.Code)
		var result []map[string]interface{}
		assert.NoError(t, json.Unmarshal(w.Body.Bytes(), &result))
		assert.Empty(t, result)
	})

	t.Run("Returns 401 when profileID missing", func(t *testing.T) {
		suite := NewTestSuite(t)
		defer suite.Cleanup()

		r := setupRecurrenceRouter()
		req := httptest.NewRequest(http.MethodGet, "/api/v1/recurrence/timeline", nil)
		w := httptest.NewRecorder()
		r.ServeHTTP(w, req)

		assert.Equal(t, http.StatusUnauthorized, w.Code)
	})
}
