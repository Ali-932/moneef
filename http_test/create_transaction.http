### 7. ATOMICITY TEST - Invalid Category ID (Should Fail and Rollback)
POST {{create}}
Authorization: Bearer {{token2}}
Content-Type: application/json

{
  "transaction_name": "Test Atomicity - Should Fail",
  "currency_code": "USD",
  "transaction_type": "expense",
  "date": "2025-01-01T12:00:00Z",
  "icon": "⚠️",
  "color": "#F44336",
  "merchant_name": "Test Merchant",
  "notes": "This should fail due to invalid category and rollback recurrence",
  "transaction_categories": [
    { "category_id": 999999, "amount": "100.00" }
  ],
  "is_recurrent": true,
  "recurrent_freq": "monthly",
  "is_active_recurrent": true,
  "recurrent_has_end_date": false
}
