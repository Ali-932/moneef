@token2 = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJlbWFpbCI6ImFsaWNlQGV4YW1wbGUuY29tIiwiZXhwIjoxNzU5MjUyMTI0fQ.NS_Vu36lmwu59bLYmHFspL-XF-k0ViZ9IRvY1yY3Ib0

### 1. Basic Transaction (Non-Recurrent) — left as-is per your note
POST {{create}}
Authorization: Bearer {{token2}}
Content-Type: application/json

{
  "transaction_name": "Lunch",
  "currency_code": "USD",
  "transaction_type": "expense",
  "date": "2025-01-01T12:00:00Z",
  "icon": "🍽️",
  "color": "#FF6B6B",
  "merchant_name": "Cafe Central",
  "notes": "Business lunch",
  "transaction_categories": [
    { "category_id":1, "amount": "20.50" }
  ]
}

### 2. Recurrent Transaction (Monthly Subscription)
POST {{create}}
Authorization: Bearer {{token2}}
Content-Type: application/json

{
  "transaction_name": "Netflix Subscription",
  "currency_code": "USD",
  "transaction_type": "expense",
  "date": "2025-01-01T12:00:00Z",
  "icon": "📺",
  "color": "#E50914",
  "merchant_name": "Netflix",
  "notes": "Monthly streaming subscription",
  "transaction_categories": [
    { "category_id": 1, "amount": "8.00" },
    { "category_id": 2, "amount": "7.99" }
  ],
  "is_recurrent": true,
  "recurrent_freq": "monthly",
  "is_active_recurrent": true,
  "recurrent_has_end_date": false
}

### 3. Recurrent Transaction with End Date (Loan Payment)
POST {{create}}
Authorization: Bearer {{token2}}
Content-Type: application/json

{
  "transaction_name": "Car Loan Payment",
  "currency_code": "USD",
  "transaction_type": "expense",
  "date": "2025-01-01T12:00:00Z",
  "icon": "🚗",
  "color": "#4CAF50",
  "merchant_name": "Bank of America",
  "notes": "Monthly car loan payment",
  "transaction_categories": [
    { "category_id": 1, "amount": "350.00" },
    { "category_id": 2, "amount": "100.00" }
  ],
  "is_recurrent": true,
  "recurrent_freq": "monthly",
  "is_active_recurrent": true,
  "recurrent_has_end_date": true,
  "recurrent_end_date": "2027-12-31T23:59:59Z",
  "recurrent_paid_previously": "1400.00",
  "recurrent_total_amount": "16800.00"
}

