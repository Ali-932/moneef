@base = http://localhost:8000
@token = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJlbWFpbCI6ImFsaWNlQGV4YW1wbGUuY29tIiwiZXhwIjoxNzgwNjU5NzExfQ.i-0pX7NUfcbez5bZOw6v2KlxF07Jn2P382GO8RaYwk8
@user = {{base}}/api/v1/user

### 1. Get profile
GET {{user}}/profile
Authorization: Bearer {{token}}

### 2. Update profile
PUT {{user}}/profile
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "first_name": "Alice",
  "last_name": "Smith"
}

### 3. Get profile after update
GET {{user}}/profile
Authorization: Bearer {{token}}

### 4. Update profile with missing fields (should fail validation)
PUT {{user}}/profile
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "first_name": ""
}

### 5. Get settings
GET {{user}}/settings
Authorization: Bearer {{token}}

### 6. Update settings (all fields)
PUT {{user}}/settings
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "currency_code": "EUR",
  "language": "ar",
  "is_notification_enabled": false,
  "is_dark_mode": true
}

### 7. Get settings after update
GET {{user}}/settings
Authorization: Bearer {{token}}

### 8. Update settings (partial — only dark mode)
PUT {{user}}/settings
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "is_dark_mode": false
}

### 9. Update settings with invalid language (should fail validation)
PUT {{user}}/settings
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "language": "fr"
}

### 10. Get profile without auth (should return 401)
GET {{user}}/profile

### 11. Get settings without auth (should return 401)
GET {{user}}/settings
