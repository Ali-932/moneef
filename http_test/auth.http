@base = http://localhost:8000
@login = {{base}}/api/v1/user/login
@register = {{base}}/api/v1/user/register

### 1. Register a new user
POST {{register}}
Content-Type: application/json

{
  "email": "newuser@example.com",
  "password": "Password123!",
  "first_name": "New",
  "last_name": "User",
  "birthday": "1995-06-15T00:00:00Z"
}

### 2. Register another user
POST {{register}}
Content-Type: application/json

{
  "email": "another@example.com",
  "password": "Password123!",
  "first_name": "Another",
  "last_name": "Person",
  "birthday": "1990-03-20T00:00:00Z"
}

### 3. Login with existing user (alice)
POST {{login}}
Content-Type: application/json

{
  "email": "alice@example.com",
  "password": "Password123!"
}

### 4. Login with wrong password (should fail)
POST {{login}}
Content-Type: application/json

{
  "email": "alice@example.com",
  "password": "WrongPassword!"
}

### 5. Login with non-existent email (should fail)
POST {{login}}
Content-Type: application/json

{
  "email": "nobody@example.com",
  "password": "Password123!"
}

### 6. Register with duplicate email (should fail with 409)
POST {{register}}
Content-Type: application/json

{
  "email": "alice@example.com",
  "password": "Password123!",
  "first_name": "Duplicate",
  "last_name": "User"
}

### 7. Register with invalid email (should fail validation)
POST {{register}}
Content-Type: application/json

{
  "email": "not-an-email",
  "password": "Password123!",
  "first_name": "Bad",
  "last_name": "Email"
}

### 8. Register with missing required fields (should fail validation)
POST {{register}}
Content-Type: application/json

{
  "email": "missing@example.com"
}
